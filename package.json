{
  "name": "waiterrobot-web",
  "version": "1.11.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --no-hmr",
    "start:lava": "ng serve --configuration lava --no-hmr",
    "build:prod": "rm -rf ./dist/WaiterRobot-Web/ && mkdir -p ./dist/WaiterRobot-Web && ng build --configuration production --verbose && cp ./LICENSE ./dist/WaiterRobot-Web/",
    "build:lava": "rm -rf ./dist/WaiterRobot-Web/ && mkdir -p ./dist/WaiterRobot-Web && ng build --configuration lava && cp ./LICENSE ./dist/WaiterRobot-Web/",
    "build:local": "rm -rf ./dist/WaiterRobot-Web/ && mkdir -p ./dist/WaiterRobot-Web && ng build --configuration local && cp ./LICENSE ./dist/WaiterRobot-Web/",
    "build:stats": "rm -rf ./dist/WaiterRobot-Web/ && mkdir -p ./dist/WaiterRobot-Web && ng build --stats-json",
    "analyze": "npm run build:stats && source-map-explorer dist/WaiterRobot-Web/**/*.js",
    "tsc:check": "tsc",
    "ci": "pnpm format",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "e2e": "ng e2e",
    "api:types": "openapi-typescript http://localhost:8080/api/swagger/api-docs -o  ./src/app/_shared/api/api-types.ts && prettier --write ./src/app/_shared/api/api-types.ts",
    "api:types:lava": "openapi-typescript https://lava.kellner.team/api/swagger/api-docs -o  ./src/app/_shared/api/api-types.ts && prettier --write ./src/app/_shared/api/api-types.ts"
  },
  "packageManager": "pnpm@10.18.2",
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.2",
    "@angular/cdk": "20.2.5",
    "@angular/common": "20.3.2",
    "@angular/compiler": "20.3.2",
    "@angular/core": "20.3.2",
    "@angular/forms": "20.3.2",
    "@angular/localize": "20.3.2",
    "@angular/platform-browser": "20.3.2",
    "@angular/platform-browser-dynamic": "20.3.2",
    "@angular/router": "20.3.2",
    "@jsverse/transloco": "7.6.1",
    "@micro-sentry/angular": "7.1.1",
    "@ng-bootstrap/ng-bootstrap": "19.0.1",
    "@ng-select/ng-select": "^20.0.0",
    "@ngrx/operators": "^20.0.0",
    "@ngrx/signals": "^20.0.0",
    "@popperjs/core": "2.11.8",
    "@swimlane/ngx-charts": "23.0.1",
    "bootstrap": "5.3.7",
    "bootstrap-icons": "^1.13.1",
    "d3-shape": "3.2.0",
    "dfts-helper": "2.0.0",
    "dfx-bootstrap-icons": "20.0.0",
    "dfx-bootstrap-table": "20.1.0",
    "dfx-helper": "20.1.0",
    "dfx-openapi": "20.1.0",
    "dfx-qrcode": "5.0.0",
    "html-to-image": "1.11.13",
    "jspdf": "3.0.3",
    "ng2-pdfjs-viewer": "20.0.1",
    "ngx-print": "20.1.0",
    "ngxtension": "5.2.0",
    "rxjs": "7.8.2",
    "tinycolor2": "^1.6.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.3",
    "@angular/cli": "20.3.3",
    "@angular/compiler-cli": "20.3.2",
    "@trivago/prettier-plugin-sort-imports": "^5.0.0",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.11",
    "@types/d3-shape": "^3.1.1",
    "@types/jasmine": "5.1.9",
    "@types/node": "^22.0.0",
    "@types/tinycolor2": "^1.4.6",
    "jasmine-core": "5.12.0",
    "jasmine-spec-reporter": "7.0.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "license-report": "^6.4.0",
    "openapi-typescript": "^7.4.2",
    "prettier": "3.6.2",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "source-map-explorer": "2.5.3",
    "typescript": "5.8.3"
  }
}
